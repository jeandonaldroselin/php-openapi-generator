#!/usr/bin/env php
<?php

declare(strict_types=1);

use JeanDonaldRoselin\OpenApiGenerator\Command\GenerateClientCommand;
use Symfony\Component\Console\Application;

$autoloadCandidates = [
    __DIR__.'/../vendor/autoload.php',       // this package's own dev checkout
    __DIR__.'/../../../autoload.php',        // installed at vendor/jeandonaldroselin/php-openapi-generator/bin/
];

$autoloadFile = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoloadFile = $candidate;
        break;
    }
}

if ($autoloadFile === null) {
    fwrite(STDERR, "Unable to locate Composer autoload.php. Run \"composer install\" first.\n");
    exit(1);
}

require $autoloadFile;

$application = new Application('generate-client');
$command = new GenerateClientCommand();
$application->add($command);
$application->setDefaultCommand((string) $command->getName(), true);

exit($application->run());
