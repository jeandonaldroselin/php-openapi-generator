{
    "name": "jeandonaldroselin/php-openapi-generator",
    "description": "Jean-Donald Roselin's PHP Openapi Generator - generates PHP API clients from OpenAPI specs and installs them into a Composer project's vendor directory.",
    "type": "library",
    "license": "MIT",
    "keywords": ["openapi", "swagger", "api-client", "code-generator", "composer"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/process": "^6.0 || ^7.0",
        "symfony/filesystem": "^6.0 || ^7.0",
        "symfony/yaml": "^6.0 || ^7.0",
        "symfony/http-client": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "JeanDonaldRoselin\\OpenApiGenerator\\": "src/"
        }
    },
    "bin": [
        "bin/generate-client"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
